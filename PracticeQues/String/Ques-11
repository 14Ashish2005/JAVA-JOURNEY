//Print a string is palindrome or not using function..

 import java.util.Scanner;
public class Main{
    public static void main(String []args){
        Scanner input = new Scanner(System.in);
        System.out.println("Enter your string:");
        String str = input.nextLine();
        // String str = "Ashish";
        System.out.println(isPalindrome(str));
    }
    static boolean isPalindrome(String str){
        String original = str;
        String reverse = reverseStr(original);
        for (int i = 0 ; i < original.length();i++){
            char ch1 = original.charAt(i);
            char ch2 = reverse.charAt(i);
            if (ch1 != ch2){
                System.out.print("This is not Palindrome string.\n");
                return false;
            }
        }
     System.out.print("This is Palindrome string.\n");
    return true;
    }
    static String reverseStr(String str){
        String reverse = "";
        int n = str.length();
        for (int i =n-1;i>=0;i--){
            char ch = str.charAt(i);
            reverse += ch;
        }
        return reverse;
    }
}


