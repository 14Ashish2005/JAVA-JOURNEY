// print the  of the values given at the index of the 2D array.

public class Main{
    public static void main(String []args){
        int arr[][] = new int[][]{{23,24,12,45},{9,56,15,23}};
        int ans = 1 ;
        for (int i = 0 ; i <arr.length; i++){
            for(int j = 0 ; j<arr[i].length;j++){
                int value = arr[i][j];
                ans *=value;
            }
        }
        System.out.println("Multiplication is: "+ans);
    }
}
