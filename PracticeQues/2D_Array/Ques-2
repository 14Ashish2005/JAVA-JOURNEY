// print the sum of the values given in 2D array.

public class Main{
    public static void main(String []args){
        int arr[][] = new int[][]{{23,24,12,45},{9,56,15,23}};
        int sum = 0 ;
        for (int i = 0 ; i <arr.length; i++){
            for(int j = 0 ; j<arr[i].length;j++){
                int value = arr[i][j];
                sum +=value;
            }
        }
        System.out.println("Sum is: "+sum);
    }
}


Output:
Sum is: 207
