Create an array , take input and print using for each loop.

import java.util.Scanner;
class Main{
    public static void main(String []args){
        Scanner input = new Scanner(System.in);
        int[] arr;
        arr =  new int[5];
        int n = arr.length;
        for(int i = 0 ; i < n ; i++){
            System.out.println("Enter your value at index:" + i);
            arr[i] = input.nextInt();
        }
        System.out.println("Your values are :");
        for(int val : arr){
            System.out.println(val);
        }
            
            
        }
        
}
