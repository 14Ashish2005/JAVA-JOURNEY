
class Pattern {
    public static void main(String[] args) {

        int n = 7;

        // Upper half
        for (int i = 0; i < n; i++) {

            // Spaces
            for (int j = 0; j < i; j++) {
                System.out.print("  ");
            }

            // Stars
            for (int j = 0; j < n - 2 * i; j++) {
                System.out.print("* ");
            }

            System.out.println();
        }

        // Lower half
        for (int i = n - 2; i >= 0; i--) {

            // Spaces
            for (int j = 0; j < i; j++) {
                System.out.print("  ");
            }

            // Stars
            for (int j = 0; j < n - 2 * i; j++) {
                System.out.print("* ");
            }

            System.out.println();
        }
    }
}
