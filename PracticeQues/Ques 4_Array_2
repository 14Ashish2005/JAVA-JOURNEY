//Print the sum of given values at iindex in an array..


public class Main
{
	public static void main(String[] args) {
		int arr[] = {10 , 20, 22, 23, 25};
		int n = arr.length;
		int sum = 0 ;
		
		for(int i =0 ; i < n; i++){
		    int value = arr[i];
		    sum = sum + value;
		}
		System.out.println("your sum is :"+ sum);
	}
}
