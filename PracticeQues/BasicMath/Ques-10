//Write a program to prrint a perfect number
//A perfect number is a positive integer that is equal to the sum of its proper divisors (all of its positive divisors excluding the number itself).

import java.util.Scanner;
public class basicMath{
  
    public static boolean perfectNum(int num){
        int sum = 1;
        for(int i = 2; i *i<=num;i++){
            if(num%i==0){
            int firstFact = i ;
            int secondFact = num/i;
            sum = sum + firstFact + secondFact;
            }
        }
        if(sum == num){
            System.out.println("perfect number..");
            return true;
        }
        else{
            System.out.println("perfect number..");
            return false;
        }
    }
    public static void main (String []args){
        Scanner input = new Scanner(System.in);
        System.out.println("enter your number :");
        int num = input.nextInt();
        

        boolean answer = perfectNum(num);
        System.out.println(answer);
    }
}
