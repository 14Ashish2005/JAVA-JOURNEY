//writee a program for an armstrong number.

import java.util.Scanner;
public class basicMath{
    public static boolean armStrongNum(int num){
       int sum = 0 ;
       int originalNum = num;
       while(num != 0){
        int digit = num% 10 ;
        int cubeOfDigit = digit * digit * digit;
        sum = sum + cubeOfDigit;
        num = num/10;
       }
       if(sum == originalNum ){
        System.out.println("yes it is  an armstrong number");
        return true;
       }
       else{
        System.out.println("no, not an armstrong number");
        return false ;
       }
    }
    public static void main (String []args){
        Scanner input = new Scanner(System.in);
        System.out.println("enter your number :");
        int num = input.nextInt();
        boolean answer = armStrongNum(num);
        System.out.println(answer);
    }
}
