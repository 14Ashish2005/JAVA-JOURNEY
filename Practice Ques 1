
class Ques{
    public static void main(String[] args){
        Scanner input = new Scanner(System.in);
        System.out.println("Enter your number :");
        int num = input.nextInt();
        // int num = 123432;
        int count = 0;
        while (num>0){
            int rem;
            rem = num%10;
            if(rem==3){
                count++;
            }
            num = num/10;

        } 
        System.out.println(count);
    }
}
